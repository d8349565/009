{
  "version": 1,
  "logging": {
    "level": "normal",
    "print_final_report": false,
    "fetch_failure_log_mode": "summary"
  },
  "search": {
    "engine_type": "tavily",
    "mode": "full",
    "max_loop_count": 3,
    "timeout": 10,
    "max_results": 30,
    "content_extract_length": 2000,
    "max_concurrent_evaluations": 3,
    "early_stop_on_satisfaction": true
  },
  "agents": {
    "requirement_analyzer": {
      "provider": "deepseek",
      "model": "deepseek-reasoner",
      "use_reasoner": true,
      "temperature": 0.3
    },
    "information_collector": {
      "provider": "bailian",
      "model": "MiniMax-M2.5",
      "use_reasoner": false,
      "temperature": 0.2
    },
    "report_writer": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "use_reasoner": true,
      "temperature": 0.7
    },
    "quality_judge": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "use_reasoner": true,
      "temperature": 0.7
    },
    "comprehensive_report_writer": {
      "provider": "bailian",
      "model": "kimi-k2.5",
      "use_reasoner": true,
      "temperature": 0.6
    }
  },
  "providers": {
    "deepseek": {
      "type": "openai_compatible",
      "api_key_env": "DEEPSEEK_API_KEY",
      "base_url_env": "DEEPSEEK_BASE_URL",
      "default_model": "deepseek-chat",
      "reasoner_model": "deepseek-reasoner",
      "capabilities": {
        "supports_temperature": true
      }
    },
    "openrouter": {
      "type": "openai_compatible",
      "api_key_env": "OPENROUTER_API_KEY",
      "base_url": "https://openrouter.ai/api/v1",
      "default_model_env": "OPENROUTER_DEFAULT_MODEL",
      "reasoner_model_env": "OPENROUTER_REASONER_MODEL",
      "capabilities": {
        "supports_temperature": true
      },
      "model_overrides": [
        {
          "model_prefix": "z-ai/",
          "capabilities": {
            "supports_temperature": false
          }
        }
      ]
    },
    "bailian": {
      "type": "openai_compatible",
      "api_key_env": "QWEN_API_KEY",
      "base_url": "https://coding.dashscope.aliyuncs.com/v1",
      "default_model_env": "QWEN_DEFAULT_MODEL",
      "reasoner_model_env": "QWEN_REASONER_MODEL",
      "default_model": "kimi-k2.5",
      "reasoner_model": "kimi-k2.5",
      "aliases": [
        "bailian"
      ],
      "capabilities": {
        "supports_temperature": true
      },
      "models": [
        {
          "id": "kimi-k2.5",
          "name": "kimi-k2.5",
          "description": ""
        },
        {
          "id": "MiniMax-M2.5",
          "name": "MiniMax-M2.5",
          "description": ""
        }
      ]
    }
  }
}
