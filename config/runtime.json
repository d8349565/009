{
  "version": 1,
  "logging": {
    "level": "normal",
    "print_final_report": false,
    "fetch_failure_log_mode": "summary"
  },
  "search": {
    "engine_type": "searxng",
    "mode": "full",
    "max_loop_count": 3,
    "timeout": 10,
    "max_results": 30,
    "content_extract_length": 5000,
    "max_concurrent_evaluations": 6,
    "early_stop_on_satisfaction": true
  },
  "agents": {
    "requirement_analyzer": {
      "provider": "qwen",
      "model": "kimi-k2.5",
      "use_reasoner": true,
      "temperature": 0.3
    },
    "information_collector": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "use_reasoner": false,
      "temperature": 0.2
    },
    "report_writer": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "use_reasoner": true,
      "temperature": 0.7
    },
    "quality_judge": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "use_reasoner": true,
      "temperature": 0.7
    },
    "comprehensive_report_writer": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "use_reasoner": true,
      "temperature": 0.7
    }
  },
  "providers": {
    "deepseek": {
      "type": "openai_compatible",
      "api_key_env": "DEEPSEEK_API_KEY",
      "base_url_env": "DEEPSEEK_BASE_URL",
      "default_model": "deepseek-chat",
      "reasoner_model": "deepseek-reasoner",
      "capabilities": {
        "supports_temperature": true
      }
    },
    "zhipu": {
      "type": "openai_compatible",
      "api_key_env": "ZHIPU_API_KEY",
      "base_url_env": "ZHIPU_BASE_URL",
      "default_model_env": "ZHIPU_DEFAULT_MODEL",
      "reasoner_model_env": "ZHIPU_ADVANCED_MODEL",
      "capabilities": {
        "supports_temperature": true
      }
    },
    "openrouter": {
      "type": "openai_compatible",
      "api_key_env": "OPENROUTER_API_KEY",
      "base_url": "https://openrouter.ai/api/v1",
      "default_model_env": "OPENROUTER_DEFAULT_MODEL",
      "reasoner_model_env": "OPENROUTER_REASONER_MODEL",
      "capabilities": {
        "supports_temperature": true
      },
      "model_overrides": [
        {
          "model_prefix": "z-ai/",
          "capabilities": {
            "supports_temperature": false
          }
        }
      ]
    },
    "qwen": {
      "type": "openai_compatible",
      "api_key_env": "QWEN_API_KEY",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "default_model_env": "QWEN_DEFAULT_MODEL",
      "reasoner_model_env": "QWEN_REASONER_MODEL",
      "default_model": "qwen-plus",
      "reasoner_model": "qwq-plus",
      "aliases": [
        "dashscope"
      ],
      "capabilities": {
        "supports_temperature": true
      },
      "models": [
        {
          "id": "qwen-plus",
          "name": "Qwen Plus",
          "description": "均衡性能，推荐"
        },
        {
          "id": "qwen-max",
          "name": "Qwen Max",
          "description": "最强性能"
        },
        {
          "id": "qwen-turbo",
          "name": "Qwen Turbo",
          "description": "快速低成本"
        },
        {
          "id": "qwen-long",
          "name": "Qwen Long",
          "description": "超长上下文"
        },
        {
          "id": "qwq-plus",
          "name": "QwQ Plus (推理)",
          "description": "深度推理模型"
        },
        {
          "id": "qwen3-235b-a22b",
          "name": "Qwen3-235B (开源)",
          "description": "开源旗舰"
        },
        {
          "id": "qwen3-32b",
          "name": "Qwen3-32B (开源)",
          "description": "开源高性能"
        },
        {
          "id": "custom",
          "name": "自定义模型...",
          "description": "手动输入模型ID"
        }
      ]
    }
  }
}
