# ============================================================
# LLM API密钥配置
# ============================================================

# DeepSeek API（默认提供商，必须配置）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 智谱AI (GLM-4) API（可选，中文理解强）
# 获取密钥: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# OpenRouter API（可选，聚合多个模型）
# 获取密钥: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
# 可选：指定默认使用的模型
OPENROUTER_DEFAULT_MODEL=xiaomi/mimo-v2-flash:free
OPENROUTER_REASONER_MODEL=openai/o1-preview

# ============================================================
# Agent模型配置 - 为每个Agent指定使用的提供商和模型
# ============================================================
# 
# 配置优先级：*_MODEL（最高） > *_PROVIDER > agent_config.py配置方案 > 系统默认
#
# 配置方式有两种：
# 
# 方式1：只指定供应商（推荐，自动使用该供应商的合适模型）
#   REQUIREMENT_ANALYZER_PROVIDER=deepseek
#
# 方式2：同时指定供应商和具体模型（精确控制）
#   REQUIREMENT_ANALYZER_PROVIDER=glm
#   REQUIREMENT_ANALYZER_MODEL=glm-4.7  # 可选，指定具体模型
#
# ============================================================
# 可用的提供商和模型：
# 
# DeepSeek供应商 (provider=deepseek):
#   - deepseek-chat      (基础模型，快速响应)
#   - deepseek-reasoner  (推理模型，复杂任务)
#
# 智谱AI供应商 (provider=glm 或 zhipu):
#   - glm-4.7       (快速模型，性价比高)
#   - glm-4.7         (高级模型，质量更好)
#
# OpenRouter供应商 (provider=openrouter):
#   - xiaomi/mimo-v2-flash:free  (Claude高级模型)
#   - openai/o1-preview           (OpenAI推理模型)
#   - 更多模型见: https://openrouter.ai/models
# ============================================================
# 
# 推荐配置方案：
# 
# 方案A - 经济型（全DeepSeek）：成本 ¥3-6/100次
#   所有Agent设为 deepseek
#   或者使用 agent_config.py 中的 ECONOMY 方案
#
# 方案B - 均衡型（推荐）：成本 ¥6-10/100次
#   REQUIREMENT_ANALYZER_PROVIDER=glm
#   REQUIREMENT_ANALYZER_MODEL=glm-4.7       # 可选
#   INFORMATION_COLLECTOR_PROVIDER=deepseek
#   REPORT_WRITER_PROVIDER=deepseek
#   QUALITY_JUDGE_PROVIDER=glm
#   或者使用 agent_config.py 中的 BALANCED 方案
#
# 方案C - 高端型：成本 ¥20-50/100次
#   REQUIREMENT_ANALYZER_PROVIDER=glm
#   REQUIREMENT_ANALYZER_MODEL=glm-4.7         # 可选
#   INFORMATION_COLLECTOR_PROVIDER=deepseek
#   REPORT_WRITER_PROVIDER=openrouter
#   REPORT_WRITER_MODEL=xiaomi/mimo-v2-flash:free  # 可选
#   QUALITY_JUDGE_PROVIDER=openrouter
#   QUALITY_JUDGE_MODEL=openai/o1-preview         # 可选
#   或者使用 agent_config.py 中的 PREMIUM 方案

# 需求分析师 (快速响应，使用基础模型)
REQUIREMENT_ANALYZER_PROVIDER=deepseek
# REQUIREMENT_ANALYZER_MODEL=deepseek-chat       # 可选：指定具体模型

# 信息收集员 (批量评估，推荐使用高性价比模型)
INFORMATION_COLLECTOR_PROVIDER=deepseek
# INFORMATION_COLLECTOR_MODEL=deepseek-chat      # 可选：指定具体模型

# 报告撰写员 (核心Agent，推荐使用高质量模型/推理模型)
REPORT_WRITER_PROVIDER=deepseek
# REPORT_WRITER_MODEL=deepseek-reasoner          # 可选：指定具体模型，推理任务用reasoner

# 质量评审员 (评估任务，使用基础模型即可)
QUALITY_JUDGE_PROVIDER=deepseek
# QUALITY_JUDGE_MODEL=deepseek-chat              # 可选：指定具体模型

# 综合报告撰写员 (深度分析，推荐使用推理模型)
COMPREHENSIVE_REPORT_WRITER_PROVIDER=deepseek
# COMPREHENSIVE_REPORT_WRITER_MODEL=deepseek-reasoner  # 可选：指定具体模型

# ============================================================
# 搜索引擎配置
# ============================================================

# Tavily搜索引擎配置（可选）
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_ENABLED=false

# SearXNG搜索引擎配置（可选）
SEARXNG_ENABLED=true
SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_API_KEY=

# 搜索引擎选择：'tavily' 或 'searxng'
SEARCH_ENGINE_TYPE=searxng

# 搜索模式配置
# SEARCH_MODE: 'quick' (快速搜索) 或 'full' (完整搜索)
SEARCH_MODE=quick

# 完整搜索模式的最大迭代次数（仅在SEARCH_MODE=full时生效）
MAX_LOOP_COUNT=1

# 是否启用优先搜索源（权威机构优先）
USE_PRIORITY_SOURCES=false

# 智能停止策略
# 首轮报告质量满足时是否自动停止（不继续迭代）
# true  = 首轮满足即停止（节省时间和API调用）
# false = 即使首轮满足，也继续迭代完整（追求完美）
EARLY_STOP_ON_SATISFACTION=true

# 性能优化配置
# 是否跳过信息评估环节（极速模式，质量会下降）
SKIP_EVALUATION=false

# 是否精简报告生成的输入数据（建议开启，大幅提速且质量影响小）
SIMPLIFY_REPORT_INPUT=true

# 数据提取内容长度（字符数）
# 影响AI能看到的文章内容长度，越长数据越完整但速度越慢
# 500  = 极速模式（5-10秒/批，但数据不完整）
# 1500 = 快速模式（8-12秒/批，数据较完整）
# 2000 = 均衡模式（10-15秒/批，数据完整，推荐）
# 3000 = 完整模式（15-20秒/批，数据很完整）
# 5000 = 最完整（25-30秒/批，最慢）
CONTENT_EXTRACT_LENGTH=2000

# 并发评估批次数
# 控制同时评估的批次数量，可大幅提速但可能触发API限流
# 1 = 串行评估（最安全，但最慢）
# 3 = 并发3批（推荐，提速70%，通常不会触发限流）
# 5 = 并发5批（激进，提速75%，可能触发限流）
# 注意：如果遇到 "Rate limit exceeded" 错误，请降低此值
MAX_CONCURRENT_EVALUATIONS=3
